{
  "entities": {
    "batches": {
      "title": "Batches",
      "description": "Lotes de producción planificados y ejecutados en la fábrica",
      "properties": {
        "id": { "type": "string", "description": "ID único del lote" },
        "recipeId": { "type": "string", "description": "ID de la receta" },
        "recipeName": { "type": "string", "description": "Nombre del producto" },
        "targetUnits": { "type": "number", "description": "Unidades objetivo planificadas" },
        "scheduledDate": { "type": "string", "description": "Fecha agendada YYYY-MM-DD" },
        "status": { "type": "string", "description": "Estado del lote: planificado, pesando, elaborando, en_freezer, completado" },
        "createdAt": { "type": "string", "description": "Timestamp ISO de creación" },
        "notes": { "type": "string", "description": "Notas operativas o turno" },
        "calculatedHours": { "type": "number", "description": "Horas calculadas de labor" },
        "calculatedF1Percent": { "type": "number", "description": "% de ocupación Freezer 1" },
        "calculatedF2Percent": { "type": "number", "description": "% de ocupación Freezer 2" },
        "freezerAssigned": { "type": "string", "description": "Freezer asignado (F1, F2, AMBOS, NINGUNO)" }
      },
      "required": ["id", "recipeId", "recipeName", "targetUnits", "scheduledDate", "status"]
    },
    "recipes": {
      "title": "Recipes",
      "description": "Fichas técnicas y recetas maestras editables de fábrica",
      "properties": {
        "id": { "type": "string", "description": "ID de la receta" },
        "name": { "type": "string", "description": "Nombre de la receta" },
        "category": { "type": "string", "description": "Categoría de producto" },
        "baseYieldUnits": { "type": "number", "description": "Rendimiento base al 100%" }
      },
      "required": ["id", "name", "category", "baseYieldUnits"]
    },
    "master_ingredients": {
      "title": "Master Ingredients",
      "description": "Catálogo maestro unificado de ingredientes y descartables",
      "properties": {
        "id": { "type": "string", "description": "ID del insumo maestro" },
        "name": { "type": "string", "description": "Nombre del insumo" },
        "categoryId": { "type": "string", "description": "Categoría asignada" },
        "defaultUnit": { "type": "string", "description": "Unidad estándar (kg, g, L, u)" }
      },
      "required": ["id", "name", "categoryId", "defaultUnit"]
    },
    "ingredient_categories": {
      "title": "Ingredient Categories",
      "description": "Configuración de categorías de insumos de compras",
      "properties": {
        "id": { "type": "string", "description": "ID de la categoría" },
        "name": { "type": "string", "description": "Nombre de la categoría" },
        "icon": { "type": "string", "description": "Emoji o icono" },
        "order": { "type": "number", "description": "Orden visual" }
      },
      "required": ["id", "name", "icon", "order"]
    },
    "production_categories": {
      "title": "Production Categories",
      "description": "Configuración de categorías de productos y recetas",
      "properties": {
        "id": { "type": "string", "description": "ID de la categoría" },
        "name": { "type": "string", "description": "Nombre de la categoría" },
        "icon": { "type": "string", "description": "Emoji o icono" },
        "order": { "type": "number", "description": "Orden visual" }
      },
      "required": ["id", "name", "icon", "order"]
    },
    "inventory_state": {
      "title": "Inventory State",
      "description": "Estado de insumos tildados, stock manual de fábrica, empaques omitidos y semanas con sábado",
      "properties": {
        "checkedItems": { "type": "object", "description": "Insumos tildados/en stock" },
        "factoryStock": { "type": "object", "description": "Stock numérico en planta" },
        "dismissedPackagingDates": { "type": "object", "description": "Fechas con empaquetado omitido" },
        "saturdayWeeks": { "type": "object", "description": "Semanas con sábado habilitado" },
        "updatedAt": { "type": "string", "description": "Timestamp ISO" }
      },
      "required": ["checkedItems", "factoryStock"]
    }
  }
}
